{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "lib": [
            "ES2022"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "dist",
        "rootDir": "..",
        "resolveJsonModule": true,
        "declaration": true,
        "sourceMap": true,
        "baseUrl": "..",
        "paths": {
            "@/*": [
                "server/src/*"
            ],
            "@shared-types/*": [
                "shared-types/src/*"
            ]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}